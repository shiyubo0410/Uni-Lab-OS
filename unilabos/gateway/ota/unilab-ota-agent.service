[Unit]
Description=Uni-Lab OTA Agent (D2: firmware; D3.B: software install + restart + rollback)
Documentation=file:///opt/unilab/current/unilabos/gateway/ota/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# D3.B：跑 root，可以 systemctl restart unilab-gateway + 写 /opt/unilab/。
# 母机首次配置见 README.md「母机出厂配置」章节。
User=root
Group=root
WorkingDirectory=/opt/unilab/current
EnvironmentFile=/etc/unilab-ota-agent.env
ExecStart=/opt/unilab/venv/bin/python -m unilabos.gateway.ota.agent

Restart=always
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unilab-ota-agent

[Install]
WantedBy=multi-user.target
