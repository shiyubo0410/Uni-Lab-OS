# Uni-Lab OTA Agent 配置文件
# 部署位置: /etc/unilab-ota-agent.env (chmod 600)

# ========= 必填 =========

# ThingsBoard MQTT 服务器
# D2 阶段: dev 机的局域网 IP (Docker 跑的 TB CE)
# 上线后: 真 TB 实例的 host
TB_HOST=10.20.31.99

# Device access token (TB UI 里 device Details → Copy access token)
TB_TOKEN=REPLACE_WITH_DEVICE_TOKEN

# 当前运行的固件标识 (必须和 TB 上传 firmware 时填的 Title 一致)
CURRENT_FW_TITLE=uni-lab-gateway
CURRENT_FW_VERSION=1.0.0

# ========= 可选（默认值见 agent.py:AgentConfig）=========

# MQTT 端口（默认 1883）
TB_PORT=1883

# MQTT QoS 等级，建议 1（at-least-once）
TB_QOS=1

# chunk 下载相关
# 单 chunk 字节数：必须 <= TB broker max packet size。
# TB Cloud 默认上限 65535 (64KB)，超过会被 broker 主动 disconnect。
# 推荐 8192 (8KB) - TB 官方文档示例就是这个值，稳。
CHUNK_SIZE=8192
# 单 chunk 响应超时（秒）
CHUNK_TIMEOUT=30
# 单 chunk 失败重试次数
CHUNK_RETRY=3

# 存储位置
DOWNLOAD_DIR=/data/ota/download
STATE_FILE=/data/ota/agent_state.json

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
