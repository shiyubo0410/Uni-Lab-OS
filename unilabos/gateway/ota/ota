#!/bin/bash
# ============================================================================
# ota — Uni-Lab IoT 网关 A/B 分区 OTA 工具
#
# 部署位置：/usr/local/bin/ota
# 调用方式：sudo ota <subcommand> [args]
#
# 子命令：
#   get-active            打印当前 active 分区标签 (A 或 B)
#   get-inactive          打印当前 inactive 分区标签
#   info                  打印所有 OTA 相关信息（active/inactive/UUID/dev）
#   write <image>         把 image 文件写入 inactive 分区（不切换）
#   verify <sha256>       校验 inactive 分区的 sha256
#   switch [<target>]     切到指定分区（不带参=切到 inactive）
#   rollback              切回 active 之前的分区（等同 switch 带反向参数）
#   help                  打印这段帮助
#
# 设计约定（OTA Agent 编程接口）：
#   - 所有"读"命令的输出是单行简单文本（grep/awk 友好）
#   - 所有"写/危险"命令必须 root，否则 exit 1
#   - 出错时 exit code != 0，错误信息打到 stderr
#   - 成功时 exit code = 0
#
# active 标识的"权威 source"：
#   /data/ota/active.txt 单字符 "A" 或 "B"
#   （/boot/orangepiEnv.txt 里的 rootdev=UUID=... 必须和它一致）
#
# 设备映射（写死，便于无歧义判断）：
#   A 分区 = /dev/mmcblk0p2
#   B 分区 = /dev/mmcblk0p3
#   boot   = /dev/mmcblk0p1
#   data   = /dev/mmcblk0p4
# ============================================================================

set -e
set -o pipefail

# ---- 配置（D1 阶段写死，后续可从配置文件读）-----------------------------
DEV_BOOT=/dev/mmcblk0p1
DEV_A=/dev/mmcblk0p2
DEV_B=/dev/mmcblk0p3
DEV_DATA=/dev/mmcblk0p4
ACTIVE_FILE=/data/ota/active.txt
ENV_FILE=/boot/orangepiEnv.txt
LOG_FILE=/data/ota/log/ota.log
# ---------------------------------------------------------------------------

# ---- 工具函数 -------------------------------------------------------------
RED='\033[0;31m'; GRN='\033[0;32m'; YEL='\033[1;33m'; NC='\033[0m'

# 日志（同时输出到 stderr 和 /data/ota/log/ota.log，便于 OTA Agent 抓）
_log() {
    local level="$1"; shift
    local msg="[$(date +'%Y-%m-%d %H:%M:%S')] [$level] $*"
    # stderr 加颜色
    case "$level" in
        ERROR) echo -e "${RED}${msg}${NC}" >&2 ;;
        WARN)  echo -e "${YEL}${msg}${NC}" >&2 ;;
        INFO)  echo -e "${GRN}${msg}${NC}" >&2 ;;
        *)     echo "$msg" >&2 ;;
    esac
    # 文件不加颜色（先检查写权限，避免 bash redirect 阶段报 Permission denied）
    local log_dir
    log_dir=$(dirname "$LOG_FILE")
    if [[ -w "$log_dir" ]] || [[ -w "$LOG_FILE" ]]; then
        echo "$msg" >> "$LOG_FILE" 2>/dev/null || true
    fi
}
log_info()  { _log INFO  "$*"; }
log_warn()  { _log WARN  "$*"; }
log_error() { _log ERROR "$*"; }
die()       { log_error "$*"; exit 1; }

# 必须 root
require_root() {
    [[ "$EUID" -eq 0 ]] || die "本子命令需要 root，请用 sudo"
}

# 把 A/B 标签转成设备路径
_label_to_dev() {
    case "$1" in
        A) echo "$DEV_A" ;;
        B) echo "$DEV_B" ;;
        *) die "非法标签 '$1'（应为 A 或 B）" ;;
    esac
}

# A↔B 反转
_invert_label() {
    case "$1" in
        A) echo B ;;
        B) echo A ;;
        *) die "非法标签 '$1'" ;;
    esac
}

# 读 active.txt 拿当前 active label
_read_active_from_file() {
    [[ -f "$ACTIVE_FILE" ]] || die "$ACTIVE_FILE 不存在，OTA 元数据损坏"
    local val
    val=$(tr -d '[:space:]' < "$ACTIVE_FILE")
    case "$val" in
        A|B) echo "$val" ;;
        *)   die "$ACTIVE_FILE 内容非法: '$val'（应为 A 或 B）" ;;
    esac
}

# 读 orangepiEnv.txt 的 rootdev UUID，反推 active label
_read_active_from_env() {
    [[ -f "$ENV_FILE" ]] || die "$ENV_FILE 不存在"
    local rootdev_uuid a_uuid b_uuid
    rootdev_uuid=$(awk -F'UUID=' '/^rootdev=UUID=/ {print $2; exit}' "$ENV_FILE")
    [[ -n "$rootdev_uuid" ]] || die "$ENV_FILE 没有 rootdev=UUID=... 行"
    # 用 lsblk 而不是 blkid——blkid 需要块设备 read 权限（普通用户没有），
    # lsblk 普通用户也能跑（从 udev/sysfs 读 UUID）
    a_uuid=$(lsblk -no UUID "$DEV_A" 2>/dev/null | head -1)
    b_uuid=$(lsblk -no UUID "$DEV_B" 2>/dev/null | head -1)
    if [[ "$rootdev_uuid" == "$a_uuid" ]]; then
        echo A
    elif [[ "$rootdev_uuid" == "$b_uuid" ]]; then
        echo B
    else
        die "$ENV_FILE 的 rootdev UUID '$rootdev_uuid' 不匹配 A/B 任何一个"
    fi
}

# 校验 active.txt 和 env 文件的一致性
_check_consistency() {
    local from_file from_env
    from_file=$(_read_active_from_file)
    from_env=$(_read_active_from_env)
    if [[ "$from_file" != "$from_env" ]]; then
        log_warn "active.txt='$from_file' 与 orangepiEnv.txt 推导出的 '$from_env' 不一致！以 orangepiEnv.txt 为准"
        echo "$from_env"
    else
        echo "$from_file"
    fi
}

# 把 A/B 标签的对应分区从 fstab/mount 卸下（防止 dd 时正在挂载）
_ensure_unmounted() {
    local label="$1"
    local dev
    dev=$(_label_to_dev "$label")
    if mount | grep -q "^${dev} "; then
        die "$dev (label=$label) 正被挂载，不能写入。请先 sudo umount $dev"
    fi
}

# 改 orangepiEnv.txt 的 rootdev 字段
_update_env_rootdev() {
    local target_label="$1" target_dev target_uuid tmp
    target_dev=$(_label_to_dev "$target_label")
    target_uuid=$(lsblk -no UUID "$target_dev" 2>/dev/null | head -1)
    [[ -n "$target_uuid" ]] || die "拿不到 $target_dev 的 UUID"
    tmp=$(mktemp)
    if grep -q '^rootdev=' "$ENV_FILE"; then
        sed "s|^rootdev=.*|rootdev=UUID=$target_uuid|" "$ENV_FILE" > "$tmp"
    else
        cat "$ENV_FILE" > "$tmp"
        echo "rootdev=UUID=$target_uuid" >> "$tmp"
    fi
    # 用 install 替代 mv：保证目标文件 mode=644（root 可写、所有人可读）。
    # 直接 mv 会保留 mktemp 默认的 600，导致普通用户没法 grep/awk orangepiEnv.txt
    install -m 644 -p "$tmp" "$ENV_FILE"
    rm -f "$tmp"
    sync
    log_info "已更新 $ENV_FILE: rootdev=UUID=$target_uuid (label=$target_label)"
}

# 改 active.txt
_update_active_file() {
    local label="$1"
    echo "$label" > "$ACTIVE_FILE"
    sync
    log_info "已更新 $ACTIVE_FILE = $label"
}

# ---- 子命令实现 ------------------------------------------------------------

cmd_get_active() {
    _check_consistency
}

cmd_get_inactive() {
    local active
    active=$(_check_consistency)
    _invert_label "$active"
}

cmd_info() {
    local active inactive a_uuid b_uuid boot_uuid data_uuid
    active=$(_check_consistency)
    inactive=$(_invert_label "$active")
    a_uuid=$(lsblk -no UUID "$DEV_A" 2>/dev/null | head -1)
    b_uuid=$(lsblk -no UUID "$DEV_B" 2>/dev/null | head -1)
    boot_uuid=$(lsblk -no UUID "$DEV_BOOT" 2>/dev/null | head -1)
    data_uuid=$(lsblk -no UUID "$DEV_DATA" 2>/dev/null | head -1)
    : "${a_uuid:=?}" "${b_uuid:=?}" "${boot_uuid:=?}" "${data_uuid:=?}"
    cat <<EOF
{
  "active": "$active",
  "inactive": "$inactive",
  "active_dev": "$(_label_to_dev "$active")",
  "inactive_dev": "$(_label_to_dev "$inactive")",
  "partitions": {
    "boot": {"dev": "$DEV_BOOT", "uuid": "$boot_uuid"},
    "A":    {"dev": "$DEV_A",    "uuid": "$a_uuid"},
    "B":    {"dev": "$DEV_B",    "uuid": "$b_uuid"},
    "data": {"dev": "$DEV_DATA", "uuid": "$data_uuid"}
  },
  "active_file": "$ACTIVE_FILE",
  "env_file": "$ENV_FILE"
}
EOF
}

cmd_write() {
    require_root
    local image="$1"; shift || true
    local target="${1:-}"  # 可选，不传 = inactive
    [[ -n "$image" ]] || die "用法: ota write <image_file> [target]"
    [[ -f "$image" ]] || die "image 文件不存在: $image"

    if [[ -z "$target" ]]; then
        target=$(_invert_label "$(_check_consistency)")
        log_info "未指定 target，自动选 inactive: $target"
    fi
    [[ "$target" == "A" || "$target" == "B" ]] || die "target 必须是 A 或 B，收到 '$target'"

    # 安全检查：不能写到当前 active
    local active
    active=$(_check_consistency)
    [[ "$target" != "$active" ]] || die "禁止写入当前 active 分区 ($active)！会破坏运行系统"

    _ensure_unmounted "$target"

    local target_dev image_size dev_size
    target_dev=$(_label_to_dev "$target")
    image_size=$(stat -c %s "$image")
    dev_size=$(blockdev --getsize64 "$target_dev")
    [[ $image_size -le $dev_size ]] || die "image 大小 ($image_size B) 超出分区容量 ($dev_size B)"

    log_info "写入 $image → $target_dev（$(numfmt --to=iec $image_size)）..."
    dd if="$image" of="$target_dev" bs=4M conv=fsync status=progress
    sync
    log_info "✓ 写入完成"

    # 计算并打印写入后的 sha256
    local sha
    sha=$(dd if="$target_dev" bs=4M count=$(( (image_size + 4*1024*1024 - 1) / (4*1024*1024) )) 2>/dev/null \
          | head -c "$image_size" \
          | sha256sum \
          | awk '{print $1}')
    echo "sha256=$sha"
}

cmd_verify() {
    require_root
    local expected_sha="$1"; shift || true
    local target="${1:-}"
    [[ -n "$expected_sha" ]] || die "用法: ota verify <expected_sha256> [target]"

    if [[ -z "$target" ]]; then
        target=$(_invert_label "$(_check_consistency)")
        log_info "未指定 target，自动选 inactive: $target"
    fi
    [[ "$target" == "A" || "$target" == "B" ]] || die "target 必须是 A 或 B"

    _ensure_unmounted "$target"

    local target_dev actual_sha image_size
    target_dev=$(_label_to_dev "$target")
    # 注意：分区可能比 image 大，sha256sum 会计算整个分区，
    # 这和 image 的 sha256 不一致。OTA Agent 应该传"分区前 N 字节" sha 或者
    # 传 image 大小作为第二参数。简化版：直接 sha 整个分区前 image_size 字节。
    # D1 先简化为 sha 整个分区，OTA Agent 自己处理截断。
    log_info "计算 $target_dev 的 sha256..."
    actual_sha=$(sha256sum "$target_dev" | awk '{print $1}')
    log_info "actual:   $actual_sha"
    log_info "expected: $expected_sha"
    if [[ "$actual_sha" == "$expected_sha" ]]; then
        log_info "✓ 校验通过"
        echo "ok"
        return 0
    else
        log_error "✗ 校验失败"
        echo "fail"
        return 2
    fi
}

cmd_switch() {
    require_root
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        target=$(_invert_label "$(_check_consistency)")
        log_info "未指定 target，自动切到 inactive: $target"
    fi
    [[ "$target" == "A" || "$target" == "B" ]] || die "target 必须是 A 或 B"

    local current
    current=$(_check_consistency)
    if [[ "$target" == "$current" ]]; then
        log_warn "目标 $target 已经是 active，无需切换"
        echo "noop"
        return 0
    fi

    log_info "切换 $current → $target"
    _update_env_rootdev "$target"
    _update_active_file "$target"
    log_info "✓ 切换完成。请 sudo reboot 使其生效"
    echo "switched=$current->$target"
}

cmd_rollback() {
    require_root
    local current target
    current=$(_check_consistency)
    target=$(_invert_label "$current")
    log_info "回滚: $current → $target（即切到另一分区）"
    cmd_switch "$target"
}

cmd_help() {
    sed -n '2,/^# =====/p' "$0" | sed 's/^# \?//'
}

# ---- main -----------------------------------------------------------------

main() {
    local subcmd="${1:-help}"
    [[ $# -gt 0 ]] && shift

    case "$subcmd" in
        get-active)   cmd_get_active  "$@" ;;
        get-inactive) cmd_get_inactive "$@" ;;
        info)         cmd_info        "$@" ;;
        write)        cmd_write       "$@" ;;
        verify)       cmd_verify      "$@" ;;
        switch)       cmd_switch      "$@" ;;
        rollback)     cmd_rollback    "$@" ;;
        help|-h|--help) cmd_help ;;
        *) die "未知子命令: $subcmd（试试 ota help）" ;;
    esac
}

main "$@"
